{
  "expo": {
    "name": "Traffic Maestro",
    "slug": "ray-arasi",
    "owner": "plustradinggs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#87c3e1",
    "ios": {
      "bundleIdentifier": "com.trafikustasi.oyun",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.trafikustasi.oyun",
      "adaptiveIcon": {
        "backgroundColor": "#87c3e1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#bfe3f7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "675d0462-3457-4cc0-95d5-4fce3856355a"
      }
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
